  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "--------------------------------------------\nMusic\n--------------------------------------------\n\nPlains
    Music: \"Cinematic Documentary\" \nby Lexin_Music \n\n\nForest Music: \"Morning
    Inside the Chest\" \nby jakob_welik\n\n\nMountains Music: \n\"Ecology Green Energy
    Atmospere \nSustainability Nature Background Music\"\nby BackgroundMusicForVideos\n\n\nCorrupted
    Plains Music:\n\"Orbit Universe Atmospheric Music\" \nby Onetent\n\n\nMenu Music:
    \"Soft Background Music\"\nby FreeMusicForVideo\n\n\nIntro Music: \"Calm Nature\"\nby
    Piano_Music\n\n\nEnding Music: \"\"\nby \n\n\nCredits Music:\n\"Documentary Cinematic
    Background Music\"\nby rediskasound"
  m_isRightToLeft: 0
