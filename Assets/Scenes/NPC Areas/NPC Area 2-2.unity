  m_Script: {fileID: 11500000, guid: 4cef57e4fc2606541b68d6eecc27e943, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextData
  _TextPageInput:
  - Yo, what's up?
  - You wanna know about what's to the East?
  - I wouldn't go there if I were you.<br>I've heard some nasty stories lately about
    that side of the region.
  _TextSpeed: 3
  _DelayBetweenLines: 0
  _DecisionAfterText: 1
  _UsesHeartCoin: 1
  _DecisionOptions:
  - Nah
  - Sure
  _PostDecisionTextDecision1:
  - What? You don't want me to?
  - Good luck using it before you lose it then.
  _PostDecisionTextDecision2:
  - Aaaaand we're done!
  - I also replenished your health while I was at it, thanks to the power of the
    Heart Coin.
  _TextSound: {fileID: 8300000, guid: f65872b0bffd2d947aa9cd117e827fa0, type: 3}
